# Browser API origin. Inlined at **build** time by Next.js.
# Changing this on Render without a new deploy does nothing.
#
# Local:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_BASE is accepted as a fallback name.

# Production (set on the rag-web service, then Redeploy):
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
